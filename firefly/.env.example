# Copy to .env and fill in. Never commit .env.

# --- Core Firefly III ---
APP_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING
APP_URL=http://localhost:8080
TZ=America/New_York
TRUSTED_PROXIES=**
SITE_OWNER=you@example.com

# Default account currency. USD/EUR/GBP/etc.
DEFAULT_LANGUAGE=en_US
DEFAULT_LOCALE=equal

# --- Database (matches docker-compose service) ---
DB_CONNECTION=mysql
DB_HOST=firefly_iii_db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Cron token (must be 32 chars, alnum). Used by the cron container. ---
STATIC_CRON_TOKEN=REPLACE_WITH_32_CHAR_ALNUM_STRING
CRON_TOKEN=REPLACE_WITH_SAME_32_CHAR_ALNUM_STRING

# --- Personal Access Token from Firefly UI -> Profile -> OAuth ---
# Required by the data importer to talk to core. Fill AFTER first login.
FIREFLY_III_ACCESS_TOKEN=

# --- Bank sync providers (fill ONE) ---
# GoCardless / Nordigen (EU + UK only). Free. Sign up at gocardless.com.
NORDIGEN_ID=
NORDIGEN_KEY=

# SimpleFIN (U.S. banks + credit cards). ~$15/yr. https://beta.bridge.simplefin.org/
SIMPLEFIN_TOKEN=
