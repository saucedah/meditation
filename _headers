/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob: https://meditation-audio.saucedah.workers.dev; connect-src 'self' https://meditation-audio.saucedah.workers.dev; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

# Long-cache the audio (immutable content, fingerprinted by deploy re-encode); SW also caches.
/audio/*
  Cache-Control: public, max-age=31536000

# The service worker and shell must always revalidate so cache-busting works.
/sw.js
  Cache-Control: no-cache
